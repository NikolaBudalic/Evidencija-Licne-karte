@{
    ViewBag.Title = "Početna";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 style="margin:0;">
            SISTEM ZA IZDAVANJE LIČNIH KARATA - ADMINISTRACIJA
        </h3>
    </div>

    <div class="panel-body">

        @if (Session["KorisnickoIme"] != null)
        {
            <h4>
                DOBRODOŠLI,
                <strong>@Session["KorisnickoIme"]</strong>
            </h4>

            <hr />

            <p>
                Informacioni sistem namenjen je evidenciji zahteva za izdavanje
                ličnih karata, obradi dokumentacije i praćenju statusa zahteva.
            </p>

            <br />

            <div class="row">

                <div class="col-md-4">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            Pregled zahteva
                        </div>
                        <div class="panel-body">
                            Pregled svih podnetih zahteva za izdavanje lične karte.
                            <br /><br />

                            @Html.ActionLink(
                                "Otvori",
                                "Index",
                                "Zahtev",
                                null,
                                new { @class = "btn btn-info" })
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="panel panel-success">
                        <div class="panel-heading">
                            Novi zahtev
                        </div>
                        <div class="panel-body">
                            Unos novog zahteva za izdavanje lične karte.
                            <br /><br />

                            @Html.ActionLink(
                                "Kreiraj",
                                "Create",
                                "Zahtev",
                                null,
                                new { @class = "btn btn-success" })
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="panel panel-warning">
                        <div class="panel-heading">
                            REST servis
                        </div>
                        <div class="panel-body">
                            Prikaz podataka o zahtevima u JSON formatu.
                            <br /><br />

                            <a href="https://localhost:44346/api/zahtevi"
                               target="_blank"
                               class="btn btn-warning">
                                REST API
                            </a>
                        </div>
                    </div>
                </div>

            </div>

            <hr />

            <h4>Osnovne funkcionalnosti sistema</h4>

            <ul>
                <li>Prijava korisnika</li>
                <li>CRUD operacije nad zahtevima</li>
                <li>Evidencija dokumentacije</li>
                <li>Praćenje statusa zahteva</li>
                <li>Parametarska štampa</li>
                <li>REST servis</li>
                <li>Repository Pattern</li>
                <li>Entity Framework Database First</li>
            </ul>
        }
        else
        {
            <h4>Niste prijavljeni.</h4>

            <p>
                Za pristup sistemu potrebno je da se prijavite.
            </p>

            @Html.ActionLink(
                "Prijava",
                "Prijava",
                "Nalog",
                null,
                new { @class = "btn btn-primary" })
        }

    </div>
</div>