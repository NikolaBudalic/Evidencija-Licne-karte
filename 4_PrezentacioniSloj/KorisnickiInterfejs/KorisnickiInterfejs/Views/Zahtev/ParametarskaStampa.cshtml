@model IEnumerable<KlasePodataka.Zahtev>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Parametarska štampa</title>

    <style>
        body {
            font-family: Arial;
            margin: 40px;
            color: #000;
        }

        .zaglavlje {
            text-align: center;
            border-bottom: 2px solid #000;
            margin-bottom: 25px;
            padding-bottom: 10px;
        }

        h2, h3 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
        }

        th, td {
            border: 1px solid #000;
            padding: 7px;
            text-align: left;
        }

        th {
            background-color: #eee;
        }

        .no-print {
            margin-bottom: 20px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="no-print">
        <button onclick="window.print()">Štampaj</button>
    </div>

    <div class="zaglavlje">
        <h2>Republika Srbija</h2>
        <h3>Sistem za izdavanje ličnih karata</h3>
        <p>Parametarska štampa zahteva</p>
    </div>

    <h3>Status zahteva: @ViewBag.Status</h3>

    <table>
        <tr>
            <th>ID</th>
            <th>JMBG</th>
            <th>Ime i prezime</th>
            <th>Datum</th>
            <th>Razlog</th>
            <th>Tip</th>
            <th>Mesto</th>
            <th>Status</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IDZahteva</td>
                <td>@item.JMBGGradjanina</td>
                <td>
                    @if (item.Gradjanin != null)
                    {
                        @(item.Gradjanin.Ime + " " + item.Gradjanin.Prezime)
                    }
                </td>
                <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy")</td>
                <td>@item.RazlogIzdavanja</td>
                <td>@item.TipZahteva</td>
                <td>@item.MestoPodnosenja</td>
                <td>@item.StatusZahteva</td>
            </tr>
        }
    </table>
</body>
</html>