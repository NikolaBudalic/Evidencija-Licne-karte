@model KlasePodataka.Zahtev

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Štampa zahteva</title>

    <style>
        body {
            font-family: Arial;
            margin: 40px;
            color: #000;
        }

        .zaglavlje {
            text-align: center;
            border-bottom: 2px solid #000;
            margin-bottom: 30px;
            padding-bottom: 10px;
        }

        h2, h3 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }

        th, td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }

        .potpis {
            margin-top: 60px;
            display: flex;
            justify-content: space-between;
            gap: 30px;
        }

            .potpis div {
                width: 33%;
                text-align: center;
            }

        .no-print {
            margin-bottom: 20px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="no-print">
        <button onclick="window.print()">Štampaj</button>
    </div>

    <div class="zaglavlje">
        <h2>Republika Srbija</h2>
        <h3>Sistem za izdavanje ličnih karata</h3>
        <p>Zahtev za izdavanje lične karte</p>
    </div>

    <h3>Podaci o zahtevu</h3>

    <table>
        <tr>
            <th>ID zahteva</th>
            <td>@Model.IDZahteva</td>
        </tr>
        <tr>
            <th>Datum podnošenja</th>
            <td>@Model.DatumPodnosenja.ToString("dd.MM.yyyy")</td>
        </tr>
        <tr>
            <th>Razlog izdavanja</th>
            <td>@Model.RazlogIzdavanja</td>
        </tr>
        <tr>
            <th>Tip zahteva</th>
            <td>@Model.TipZahteva</td>
        </tr>
        <tr>
            <th>Mesto podnošenja</th>
            <td>@Model.MestoPodnosenja</td>
        </tr>
        <tr>
            <th>Status zahteva</th>
            <td>@Model.StatusZahteva</td>
        </tr>
    </table>

    <h3>Podaci o građaninu</h3>

    <table>
        <tr>
            <th>JMBG</th>
            <td>@Model.Gradjanin.JMBG</td>
        </tr>
        <tr>
            <th>Ime i prezime</th>
            <td>@Model.Gradjanin.Ime @Model.Gradjanin.Prezime</td>
        </tr>
        <tr>
            <th>Datum rođenja</th>
            <td>@Model.Gradjanin.DatumRodjenja.ToString("dd.MM.yyyy")</td>
        </tr>
        <tr>
            <th>Pol</th>
            <td>@Model.Gradjanin.Pol</td>
        </tr>
        <tr>
            <th>Državljanstvo</th>
            <td>@Model.Gradjanin.Drzavljanstvo</td>
        </tr>
        <tr>
            <th>Adresa prebivališta</th>
            <td>@Model.Gradjanin.AdresaPrebivalista</td>
        </tr>
        <tr>
            <th>Kontakt telefon</th>
            <td>@Model.Gradjanin.KontaktTelefon</td>
        </tr>
    </table>

    <h3>Dokumentacija</h3>

    <table>
        <tr>
            <th>Naziv dokumenta</th>
            <th>Dostavljeno</th>
        </tr>

        @foreach (var d in Model.Dokumentacijas)
        {
            <tr>
                <td>@d.NazivDokumenta</td>
                <td>@(d.Dostavljeno ? "Da" : "Ne")</td>
            </tr>
        }
    </table>

    @if (Model.RoditeljStarateljs != null && Model.RoditeljStarateljs.Any())
    {
        <h3>Podaci o roditelju/staratelju</h3>

        <table>
            @foreach (var roditelj in Model.RoditeljStarateljs)
            {
                <tr>
                    <th>Ime i prezime roditelja/staratelja</th>
                    <td>@roditelj.ImePrezime</td>
                </tr>
                <tr>
                    <th>JMBG roditelja/staratelja</th>
                    <td>@roditelj.JMBG</td>
                </tr>
                <tr>
                    <th>Srodstvo</th>
                    <td>@roditelj.Srodstvo</td>
                </tr>
                <tr>
                    <th>Kontakt telefon</th>
                    <td>@roditelj.KontaktTelefon</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@roditelj.Email</td>
                </tr>
            }
        </table>
    }

    @if (Model.RoditeljStarateljs != null && Model.RoditeljStarateljs.Any())
    {
        <div class="potpis">
            <div>
                _______________________<br />
                Podnosilac zahteva
            </div>

            <div>
                _______________________<br />
                Roditelj/staratelj
            </div>

            <div>
                _______________________<br />
                Službeno lice
            </div>
        </div>
    }
    else
    {
        <div class="potpis">
            <div>
                _______________________<br />
                Podnosilac zahteva
            </div>

            <div>
                _______________________<br />
                Službeno lice
            </div>
        </div>
    }
</body>
</html>