@model KlasePodataka.Zahtev

@{
    ViewBag.Title = "Izmena zahteva";
}

<div class="page-header">
    <h2>Izmena zahteva #@Model.IDZahteva</h2>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IDZahteva)

    <div class="panel panel-warning">
        <div class="panel-heading">
            <strong>Podaci zahteva</strong>
        </div>

        <div class="panel-body">
            <div class="row">
                <div class="col-md-4 form-group">
                    @Html.LabelFor(m => m.RazlogIzdavanja)
                    @Html.DropDownListFor(
                        m => m.RazlogIzdavanja,
                        new SelectList(new[] { "Prvo izdavanje", "Zamena", "Gubitak", "Oštećenje" }, Model.RazlogIzdavanja),
                        "-- Izaberite razlog --",
                        new { @class = "form-control" })
                </div>

                <div class="col-md-4 form-group">
                    @Html.LabelFor(m => m.TipZahteva)
                    @Html.DropDownListFor(
                        m => m.TipZahteva,
                        new SelectList(new[] { "Redovan", "Hitan" }, Model.TipZahteva),
                        "-- Izaberite tip --",
                        new { @class = "form-control" })
                </div>

                <div class="col-md-4 form-group">
                    @Html.LabelFor(m => m.StatusZahteva)
                    @Html.DropDownListFor(
                        m => m.StatusZahteva,
                        new SelectList(new[] { "Podnet", "Odobren", "Odbijen", "U obradi" }, Model.StatusZahteva),
                        "-- Izaberite status --",
                        new { @class = "form-control" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.MestoPodnosenja)
                @Html.TextBoxFor(m => m.MestoPodnosenja, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Napomena)
                @Html.TextAreaFor(m => m.Napomena, new { @class = "form-control", rows = "4" })
            </div>
        </div>
    </div>

    <div class="panel panel-info">
        <div class="panel-heading">
            <strong>Dokumentacija</strong>
        </div>

        <div class="panel-body">
            @if (Model.Dokumentacijas != null && Model.Dokumentacijas.Any())
            {
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Naziv dokumenta</th>
                            <th class="text-center">Dostavljeno</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dokument in Model.Dokumentacijas)
                        {
                            <tr>
                                <td>@dokument.NazivDokumenta</td>
                                <td class="text-center">
                                    <input type="checkbox"
                                           disabled="disabled"
                                           @(dokument.Dostavljeno ? "checked=\"checked\"" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Za ovaj zahtev nije evidentirana dokumentacija.</p>
            }
        </div>
    </div>

    <input type="submit" value="Sačuvaj izmene" class="btn btn-primary btn-lg" />
    @Html.ActionLink("Nazad na listu", "Spisak", null, new { @class = "btn btn-default btn-lg" })
}