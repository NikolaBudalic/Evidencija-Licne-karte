@model IEnumerable<KlasePodataka.Zahtev>

@{
    ViewBag.Title = "Pregled zahteva";
}

<div class="page-header">
    <h2>Pregled zahteva za izdavanje lične karte</h2>
</div>

<div class="panel panel-default">
    <div class="panel-body">

        <div class="row">

            <div class="col-md-8">

                @using (Html.BeginForm("Spisak", "Zahtev", FormMethod.Get))
                {
                    <div class="form-inline">

                        <input type="text"
                               name="pretraga"
                               class="form-control"
                               style="width:390px;"
                               placeholder="Pretraži po ID-u, JMBG-u, imenu, prezimenu ili statusu..."
                               value="@ViewBag.Pretraga" />

                        <button class="btn btn-primary" type="submit">
                            <span class="glyphicon glyphicon-search"></span>
                            Pretraži
                        </button>

                        @Html.ActionLink(
                            "Prikaži sve",
                            "Spisak",
                            "Zahtev",
                            null,
                            new { @class = "btn btn-default" })

                    </div>
                }

            </div>

            <div class="col-md-4 text-right">

                @Html.ActionLink(
                    "Novi zahtev",
                    "Dodaj",
                    "Zahtev",
                    null,
                    new { @class = "btn btn-success" })

            </div>

        </div>

        <hr />

        <div>
            @Html.ActionLink(
                "Štampa odobrenih",
                "ParametarskaStampa",
                new { status = "Odobren" },
                new { @class = "btn btn-default", target = "_blank" })

            @Html.ActionLink(
                "Štampa podnetih",
                "ParametarskaStampa",
                new { status = "Podnet" },
                new { @class = "btn btn-default", target = "_blank" })
        </div>

    </div>
</div>

@if (!String.IsNullOrWhiteSpace(Convert.ToString(ViewBag.Pretraga)))
{
    <div class="alert alert-info">
        Prikazani su rezultati pretrage za pojam:
        <strong>@ViewBag.Pretraga</strong>
    </div>
}

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>JMBG</th>
            <th>Ime i prezime</th>
            <th>Datum</th>
            <th>Razlog</th>
            <th>Tip</th>
            <th>Mesto</th>
            <th>Status</th>
            <th style="width:360px;">Akcije</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.IDZahteva</td>
                    <td>@item.JMBGGradjanina</td>
                    <td>
                        @if (item.Gradjanin != null)
                        {
                            @(item.Gradjanin.Ime + " " + item.Gradjanin.Prezime)
                        }
                    </td>
                    <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy")</td>
                    <td>@item.RazlogIzdavanja</td>
                    <td>@item.TipZahteva</td>
                    <td>@item.MestoPodnosenja</td>
                    <td>@item.StatusZahteva</td>
                    <td style="white-space:nowrap;">
                        <a href="@Url.Action("Detalji", new { id = item.IDZahteva })"
                           class="btn btn-info btn-sm">Detalji</a>

                        <a href="@Url.Action("Izmeni", new { id = item.IDZahteva })"
                           class="btn btn-warning btn-sm">Izmeni</a>

                        <a href="@Url.Action("Stampa", new { id = item.IDZahteva })"
                           target="_blank"
                           class="btn btn-default btn-sm">Štampa</a>

                        @if (Session["Uloga"] != null && Session["Uloga"].ToString() == "Administrator")
                        {
                            <a href="@Url.Action("Obrisi", new { id = item.IDZahteva })"
                               class="btn btn-danger btn-sm">Obriši</a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted">
                    Nema pronađenih zahteva za zadati kriterijum.
                </td>
            </tr>
        }
    </tbody>
</table>