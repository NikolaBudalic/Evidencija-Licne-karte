@model IEnumerable<KlasePodataka.Zahtev>

@{
    ViewBag.Title = "Pregled zahteva";
}

<div class="page-header">
    <h2>Pregled zahteva za izdavanje lične karte</h2>
</div>

<div class="well">
    @Html.ActionLink("Novi zahtev", "Create", "Zahtev", null, new { @class = "btn btn-primary" })

    @Html.ActionLink(
        "Štampa odobrenih",
        "ParametarskaStampa",
        new { status = "Odobren" },
        new { @class = "btn btn-default", target = "_blank" })

    @Html.ActionLink(
        "Štampa podnetih",
        "ParametarskaStampa",
        new { status = "Podnet" },
        new { @class = "btn btn-default", target = "_blank" })
</div>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>JMBG</th>
            <th>Ime i prezime</th>
            <th>Datum</th>
            <th>Razlog</th>
            <th>Tip</th>
            <th>Mesto</th>
            <th>Status</th>
            <th style="width:360px;">Akcije</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IDZahteva</td>
                <td>@item.JMBGGradjanina</td>
                <td>
                    @if (item.Gradjanin != null)
                    {
                        @(item.Gradjanin.Ime + " " + item.Gradjanin.Prezime)
                    }
                </td>
                <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy")</td>
                <td>@item.RazlogIzdavanja</td>
                <td>@item.TipZahteva</td>
                <td>@item.MestoPodnosenja</td>
                <td>@item.StatusZahteva</td>
                <td style="white-space:nowrap;">
                    <a href="@Url.Action("Details", new { id = item.IDZahteva })" class="btn btn-info btn-sm">Detalji</a>
                    <a href="@Url.Action("Edit", new { id = item.IDZahteva })" class="btn btn-warning btn-sm">Izmeni</a>
                    <a href="@Url.Action("Stampa", new { id = item.IDZahteva })" target="_blank" class="btn btn-default btn-sm">Štampa</a>

                    @if (Session["Uloga"] != null && Session["Uloga"].ToString() == "Administrator")
                    {
                        <a href="@Url.Action("Delete", new { id = item.IDZahteva })" class="btn btn-danger btn-sm">Obriši</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>