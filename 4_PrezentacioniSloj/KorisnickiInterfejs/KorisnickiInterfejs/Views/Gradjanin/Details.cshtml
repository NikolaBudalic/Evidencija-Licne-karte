@model KlasePodataka.Gradjanin

@{
    ViewBag.Title = "Detalji građanina";
}

<div class="page-header">
    <h2>Detalji građanina</h2>
</div>

<div class="panel panel-info">
    <div class="panel-heading">
        <strong>Podaci o građaninu</strong>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>JMBG</dt>
            <dd>@Model.JMBG</dd>

            <dt>Ime</dt>
            <dd>@Model.Ime</dd>

            <dt>Prezime</dt>
            <dd>@Model.Prezime</dd>

            <dt>Datum rođenja</dt>
            <dd>@Model.DatumRodjenja.ToString("dd.MM.yyyy")</dd>

            <dt>Pol</dt>
            <dd>@Model.Pol</dd>

            <dt>Državljanstvo</dt>
            <dd>@Model.Drzavljanstvo</dd>

            <dt>Adresa prebivališta</dt>
            <dd>@Model.AdresaPrebivalista</dd>

            <dt>Kontakt telefon</dt>
            <dd>@Model.KontaktTelefon</dd>

            <dt>Email</dt>
            <dd>@Model.Email</dd>

            <dt>Broj stare LK</dt>
            <dd>@Model.BrojStareLK</dd>

            <dt>Datum isteka LK</dt>
            <dd>
                @(Model.DatumIstekaLK.HasValue
                    ? Model.DatumIstekaLK.Value.ToString("dd.MM.yyyy")
                    : "-")
            </dd>
        </dl>
    </div>
</div>

@Html.ActionLink("Nazad na listu", "Index", null, new { @class = "btn btn-default" })