@model KlasePodataka.Gradjanin

@{
    ViewBag.Title = "Brisanje građanina";
}

<h2>Brisanje građanina</h2>

<div class="alert alert-warning">
    Da li ste sigurni da želite da obrišete ovog građanina?
</div>

<div class="panel panel-danger">
    <div class="panel-heading">
        Podaci o građaninu
    </div>

    <table class="table table-bordered">
        <tr>
            <th>JMBG</th>
            <td>@Model.JMBG</td>
        </tr>

        <tr>
            <th>Ime</th>
            <td>@Model.Ime</td>
        </tr>

        <tr>
            <th>Prezime</th>
            <td>@Model.Prezime</td>
        </tr>

        <tr>
            <th>Datum rođenja</th>
            <td>@Model.DatumRodjenja.ToString("dd.MM.yyyy")</td>
        </tr>

        <tr>
            <th>Pol</th>
            <td>@Model.Pol</td>
        </tr>

        <tr>
            <th>Državljanstvo</th>
            <td>@Model.Drzavljanstvo</td>
        </tr>

        <tr>
            <th>Adresa prebivališta</th>
            <td>@Model.AdresaPrebivalista</td>
        </tr>

        <tr>
            <th>Kontakt telefon</th>
            <td>@Model.KontaktTelefon</td>
        </tr>

        <tr>
            <th>E-mail</th>
            <td>@Model.Email</td>
        </tr>
    </table>
</div>

@using (Html.BeginForm("DeleteConfirmed", "Gradjanin", new { id = Model.JMBG }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Potvrdi brisanje</button>
    @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-default" })
}