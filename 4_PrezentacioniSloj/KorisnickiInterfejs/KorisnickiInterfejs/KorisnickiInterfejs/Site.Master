<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="KorisnickiInterfejs.SiteMaster" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="sr">
<head runat="server">
    <title>Sistem za izdavanje ličnih karata</title>

    <link href="~/Styles/Site.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form runat="server">

    <div class="page">

        <div class="header">

            <div class="title">
                <h1>
                    SISTEM ZA IZDAVANJE LIČNIH KARATA
                </h1>
            </div>

            <div class="loginDisplay">
                <asp:HyperLink ID="HyperLink1"
                    runat="server"
                    Font-Bold="True"
                    Font-Size="Medium"
                    Font-Underline="True"
                    ForeColor="White"
                    NavigateUrl="~/Login.aspx">
                    PRIJAVA
                </asp:HyperLink>
            </div>

            <div class="clear hideSkiplink">

                <asp:Menu ID="NavigationMenu"
                    runat="server"
                    CssClass="menu"
                    EnableViewState="false"
                    IncludeStyleBlock="false"
                    Orientation="Horizontal">

                    <Items>

                        <asp:MenuItem
                            NavigateUrl="~/Default.aspx"
                            Text="POČETNA"
                            Value="POČETNA" />

                        <asp:MenuItem
                            NavigateUrl="~/About.aspx"
                            Text="AUTOR"
                            Value="AUTOR">
                        </asp:MenuItem>

                    </Items>

                </asp:Menu>

            </div>

        </div>

        <div class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"/>
        </div>

        <div class="clear">
        </div>

    </div>

    <div class="footer">
        
        Copyright - Ljubica Kazi @ Tehnički fakultet &quot;Mihajlo Pupin&quot; Zrenjanin, 2024.
    </div>

    </form>
</body>
</html>